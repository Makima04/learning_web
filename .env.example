# LLM 网关（也可放 ew_llm.json，二选一；环境变量优先）
EW_LLM_URL=
EW_LLM_KEY=
EW_LLM_MODEL=
# 会话有效期天数（默认 30）
EW_SESSION_TTL_DAYS=30
# 是否允许首位注册用户自动成为管理员（默认 1；对外暴露部署设 0）
EW_ALLOW_FIRST_ADMIN=1
# PostgreSQL（Rust 后端）
EW_DATABASE_URL=postgres://makima@localhost/english_web
# 监听
EW_HOST=0.0.0.0
EW_PORT=8000
# 静态目录（默认 frontend/dist）
# EW_STATIC_DIR=/path/to/frontend/dist
